DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/miniveeva

# Change this in real environments.
JWT_SECRET=dev-change-me
JWT_EXPIRE_MINUTES=1440

# Frontend dev server
CORS_ORIGINS=["http://localhost:5173"]

# Create tables and insert demo records.
# For production deployments, set this to `false` (demo seeding typically handled separately).
SEED_ON_STARTUP=false
SEED_USER_PASSWORD=Password123!

# Security guard: by default new signups become Researcher.
ROLE_ASSIGNMENT_ON_SIGNUP=false

